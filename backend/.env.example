# Comma-separated browser origins. Use exact HTTPS origins in deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode disables packet capture and destructive database clearing.
NETSHIELD_DEMO_MODE=false
NETSHIELD_CAPTURE_ENABLED=true

# Optional. Relative values resolve from the backend directory.
NETSHIELD_DATA_DIR=data
NETSHIELD_LOG_DIR=logs

# Initial accounts are created only when the users table is empty.
NETSHIELD_ADMIN_PASSWORD=Admin123!
NETSHIELD_ANALYST_PASSWORD=Analyst123!
